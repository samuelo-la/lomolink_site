Options -Indexes

RewriteEngine On
# One canonical address: https://lomolinkconsulting.com (no www).
# If SSL terminates at a proxy, use X-Forwarded-Proto here instead of HTTPS.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://lomolinkconsulting.com%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

<FilesMatch "(^\.|\.map$|^contact\.config(\.example)?\.php$|^form-lib\.php$)">
	Require all denied
</FilesMatch>

# Headers are sent only when mod_headers is enabled; verify them after deployment.
<IfModule mod_headers.c>
	Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	# Short while testing. Raise to "max-age=31536000" once HTTPS is confirmed working
	# (add includeSubDomains only if every subdomain has a valid certificate).
	Header always set Strict-Transport-Security "max-age=300"
</IfModule>

# Caching, matched on the request address so contact.php keeps its own no-store header.
# - /_astro/ files have content hashes in their names, so they can be cached for a year.
# - Pages (addresses ending in / or .html) are revalidated on every visit so updates show at once.
<IfModule mod_setenvif.c>
	SetEnvIf Request_URI "^/_astro/" ASTRO_ASSET
	SetEnvIf Request_URI "(/|\.html)$" HTML_PAGE
</IfModule>
<IfModule mod_headers.c>
	Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
	Header set Cache-Control "no-cache" env=HTML_PAGE
</IfModule>
