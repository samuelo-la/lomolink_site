---
import ContactSection from '../components/ContactSection.astro';
import Container from '../components/Container.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FeatureColumns from '../components/FeatureColumns.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SplitFeature from '../components/SplitFeature.astro';
import type { IconName } from '../components/icons/paths';
import { enquiryHref, routes } from '../data/routes';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/images/about_us_banner.png';
import welcomeImage from '../assets/images/About Us welcoming approach section.png';

const services: { icon: IconName; title: string; text: string }[] = [
	{ icon: 'graduation-cap', title: 'Education guidance', text: 'Support to explore study options and prepare applications.' },
	{ icon: 'award', title: 'Training and development', text: 'Help to identify courses that match your skills and goals.' },
	{ icon: 'heart-pulse', title: 'Healthcare recruitment', text: 'Support for candidates and employers seeking a suitable match.' },
];

const principles: { icon: IconName; title: string; text: string }[] = [
	{ icon: 'ear', title: 'We listen', text: 'We take time to understand your background, experience and goals.' },
	{ icon: 'chat', title: 'We explain', text: 'We give clear, practical information about your options.' },
	{ icon: 'calendar-check', title: 'We plan', text: 'We help you explore suitable next steps and prepare for them.' },
	{ icon: 'users', title: 'We support', text: 'We stay in touch and offer guidance as you move forward.' },
];
---

<BaseLayout
	title="About Us | Lomolink Consulting"
	description="Lomolink Consulting provides education guidance, training support and healthcare recruitment services, with personalised support shaped around your background and ambitions."
>
	<Hero
		eyebrow={`About ${site.name}`}
		titleLines={['Guidance shaped', 'around your future.']}
		text="We help people explore education, develop skills and take practical steps towards their career goals."
		image={heroImage}
		imageAlt="Three advisers smiling as they review a document together at an office table."
		imagePosition="object-[55%_50%]"
	/>

	<section class="py-12 lg:py-20">
		<Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<div data-reveal>
				<SectionHeading id="who-heading" align="left">Who we are</SectionHeading>
				<div class="mt-6 space-y-4 text-lg leading-relaxed text-dark-grey">
					<p>{site.name} provides education guidance, training support and healthcare recruitment services. We take time to understand your background, experience and ambitions so we can help you explore suitable next steps.</p>
					<p>Whether you are returning to learning, considering a new qualification or planning a career change, we offer clear information and personalised support.</p>
				</div>
			</div>
			<div class="rounded-xl bg-teal-pale p-8 shadow-card lg:p-10" data-reveal data-reveal-delay="1">
				<h2 class="font-display text-2xl font-semibold text-navy">Our purpose</h2>
				<span class="mt-3 block h-[3px] w-12 bg-gold" aria-hidden="true"></span>
				<p class="mt-6 font-display text-[28px] leading-tight font-semibold text-balance text-navy lg:text-4xl">To help people make informed choices about learning and work.</p>
				<p class="mt-6 text-lg leading-relaxed text-dark-grey">We believe your existing knowledge and experience are a valuable starting point for your next chapter.</p>
			</div>
		</Container>
	</section>

	<section class="pb-12 lg:pb-20" aria-labelledby="what-heading">
		<Container>
			<SectionHeading id="what-heading">What we do</SectionHeading>
			<div class="mx-auto mt-10 grid max-w-2xl gap-6 lg:max-w-none lg:grid-cols-3">
				{services.map((service, i) => (
					<div data-reveal data-reveal-delay={String(i)}>
						<ServiceCard {...service} />
					</div>
				))}
			</div>
		</Container>
	</section>

	<SplitFeature
		id="welcome-heading"
		title="A welcoming approach"
		action={{ label: 'Explore refugee education support', href: routes.refugeeSupport }}
		image={welcomeImage}
		imageAlt="An adviser talks with three adults of different ages around a table in a bright community library."
	>
		<p>We welcome people from all backgrounds and countries, including people with refugee status and LGBTIQ+ learners. We listen with respect and focus on your ambitions, circumstances and practical next steps.</p>
	</SplitFeature>

	<section class="py-12 lg:py-20" aria-labelledby="how-heading">
		<Container>
			<SectionHeading id="how-heading">How we work</SectionHeading>
			<div class="mt-10">
				<FeatureColumns items={principles} />
			</div>
		</Container>
	</section>

	<CtaBanner
		id="organisations-heading"
		title="For organisations and employers"
		text="We welcome conversations about referrals, learning opportunities and recruitment needs."
		action={{ label: 'Discuss working together', href: enquiryHref('partnership') }}
	/>

	<ContactSection title="Let’s talk about your next step" />
</BaseLayout>
