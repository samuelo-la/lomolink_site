---
import ContactForm from '../components/ContactForm.astro';
import ContactList from '../components/ContactList.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/images/Contact and Enquiries page.png';
---

<BaseLayout
	title={`Contact Us | ${site.name}`}
	description="Get in touch with Lomolink Consulting about study options, training, health and social care recruitment or support for learners with refugee status."
>
	<Hero
		eyebrow="Contact and enquiries"
		titleLines={['Let’s talk about', 'your next step.']}
		text="Whether you are exploring study options, looking for your next role or seeking staff, start with a conversation. You do not need to have every answer before getting in touch."
		image={heroImage}
		imageAlt="A smiling adviser talks on the telephone at her desk with a laptop and an open notebook."
		imagePosition="object-[55%_40%]"
	/>

	<section class="py-12 lg:py-20">
		<Container class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
			<div>
				<SectionHeading id="details-heading" align="left">Contact details</SectionHeading>
				<p class="mt-6 text-lg leading-relaxed text-dark-grey">Send us a message using the form, or contact us directly by email or telephone.</p>
				<div class="mt-8">
					<ContactList layout="stack" />
				</div>
			</div>

			<div class="rounded-xl border border-navy/10 bg-white p-6 shadow-card sm:p-8 lg:p-10">
				<h2 id="form-heading" class="font-display text-2xl font-semibold text-navy lg:text-[28px]">Send us a message</h2>
				<span class="mt-3 mb-8 block h-[3px] w-12 bg-gold" aria-hidden="true"></span>
				<ContactForm />
			</div>
		</Container>
	</section>
</BaseLayout>
