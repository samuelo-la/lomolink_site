---
import ContactList from '../../components/ContactList.astro';
import Container from '../../components/Container.astro';
import EmployerForm from '../../components/EmployerForm.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title={`Tell us who you need | Health and Social Care Recruitment | ${site.name}`}
	description="Domiciliary care services, care homes and supported living services: tell Lomolink Consulting about the role you need to fill."
>
	<PageHeader
		eyebrow="Health and social care recruitment"
		title="Tell us who you need"
		intro="Whether you run a domiciliary care service, care home or supported living service, tell us about the role you need to fill."
	/>

	<section class="py-12 lg:py-20">
		<Container class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
			<div class="space-y-8">
				<div>
					<SectionHeading id="next-heading" align="left">What happens next</SectionHeading>
					<p class="mt-6 text-lg leading-relaxed text-dark-grey">Employers share their staffing requirements. We’ll discuss the role with you and agree what recruitment support you need.</p>
				</div>
				<div class="rounded-xl bg-cream p-5 text-sm leading-relaxed text-dark-grey">
					<h2 class="font-semibold text-navy">How we can help</h2>
					<ul class="mt-3 space-y-2">
						<li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-teal" aria-hidden="true"></span>Identify suitable candidates</li>
						<li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-teal" aria-hidden="true"></span>Carry out initial screening against your requirements</li>
						<li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-teal" aria-hidden="true"></span>Coordinate interviews</li>
						<li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-teal" aria-hidden="true"></span>Discuss training needs before candidates start</li>
					</ul>
				</div>
				<div>
					<h2 class="font-semibold text-navy">Prefer to talk first?</h2>
					<div class="mt-4">
						<ContactList layout="stack" />
					</div>
				</div>
			</div>

			<div class="rounded-xl border border-navy/10 bg-white p-6 shadow-card sm:p-8 lg:p-10">
				<h2 class="font-display text-2xl font-semibold text-navy lg:text-[28px]">Your staffing enquiry</h2>
				<span class="mt-3 mb-8 block h-[3px] w-12 bg-gold" aria-hidden="true"></span>
				<EmployerForm />
			</div>
		</Container>
	</section>
</BaseLayout>
