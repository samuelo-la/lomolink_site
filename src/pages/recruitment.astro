---
import ContactSection from '../components/ContactSection.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import IconCard from '../components/IconCard.astro';
import ListCard from '../components/ListCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SplitFeature from '../components/SplitFeature.astro';
import type { IconName } from '../components/icons/paths';
import { routes } from '../data/routes';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/images/Healthcare Recruitment page.png';
import prepareImage from '../assets/images/Healthcare Recruitment candidate preparation section.png';

const register = { label: 'Register your interest', href: routes.recruitmentRegister };
const employers = { label: 'Tell us who you need', href: routes.recruitmentEmployers };

const nextSteps: { icon: IconName; title: string; text: string }[] = [
	{ icon: 'users', title: 'Candidates', text: 'Candidates share their details so we can understand what roles may suit them. We’ll get in touch if there’s a suitable opportunity to discuss.' },
	{ icon: 'building', title: 'Employers', text: 'Employers share their staffing requirements. We’ll discuss the role with you and agree what recruitment support you need.' },
];

const roles: { icon: IconName; title: string }[] = [
	{ icon: 'users', title: 'Care assistants and support workers' },
	{ icon: 'house', title: 'Domiciliary care workers' },
	{ icon: 'building', title: 'Care homes and supported living services' },
];
---

<BaseLayout
	title={`Health and Social Care Recruitment | ${site.name}`}
	description="Lomolink Consulting helps candidates find suitable roles in UK health and social care and supports care providers looking for staff."
>
	<Hero
		eyebrow="Health and social care recruitment"
		titleLines={['Connecting people', 'with care opportunities.']}
		text={`${site.name} helps candidates find suitable roles in UK health and social care and supports care providers looking for staff. We work with candidates and employers to understand what each role requires, from experience and training to location and availability.`}
		primary={register}
		secondary={employers}
		image={heroImage}
		imageAlt="Three care workers in uniform chatting and smiling together in a bright care home lounge."
		imagePosition="object-[50%_35%]"
	/>

	<section class="py-12 lg:py-20" aria-labelledby="support-heading">
		<Container>
			<SectionHeading id="support-heading">Support for candidates and care providers</SectionHeading>
			<div class="mt-10 grid gap-6 lg:grid-cols-2">
				<div data-reveal>
					<ListCard
						icon="users"
						title="For candidates"
						intro="Looking for a role as a care assistant, support worker or domiciliary care worker? Tell us about your experience, where you can work and the shifts you’re available for."
						points={['Help preparing your CV', 'Support getting ready for interviews', 'Identifying any training you may need', 'An introduction to the employer when a suitable vacancy is available']}
						action={register}
					/>
				</div>
				<div data-reveal data-reveal-delay="1">
					<ListCard
						icon="building"
						title="For care providers"
						intro="Whether you run a domiciliary care service, care home or supported living service, tell us about the role you need to fill."
						points={['Identifying suitable candidates', 'Initial screening against your requirements', 'Coordinating interviews', 'Discussing training needs before candidates start']}
						action={employers}
					/>
				</div>
			</div>
		</Container>
	</section>

	<section class="bg-cream py-12 lg:py-20" aria-labelledby="next-heading">
		<Container>
			<SectionHeading id="next-heading">What happens next</SectionHeading>
			<ul class="mt-10 grid gap-6 lg:grid-cols-2">
				{nextSteps.map((step, i) => (
					<li data-reveal data-reveal-delay={String(i)}>
						<IconCard {...step} />
					</li>
				))}
			</ul>
		</Container>
	</section>

	<section class="py-12 lg:py-20" aria-labelledby="roles-heading">
		<Container>
			<SectionHeading id="roles-heading">Roles and settings</SectionHeading>
			<ul class="mx-auto mt-10 grid max-w-xl gap-6 xl:max-w-none xl:grid-cols-3">
				{roles.map((role, i) => (
					<li data-reveal data-reveal-delay={String(i)}>
						<IconCard {...role} />
					</li>
				))}
			</ul>
			<p class="mt-8 text-center text-dark-grey">
				<a href={routes.contact} class="font-semibold text-teal underline-offset-4 hover:text-navy hover:underline">Contact us</a> to discuss current vacancies and the roles we can support.
			</p>
		</Container>
	</section>

	<SplitFeature
		id="prepare-heading"
		title="Prepare for your next opportunity"
		action={{ label: 'Explore education and training', href: routes.educationTraining }}
		image={prepareImage}
		imageAlt="A recruitment adviser reviews a document with a candidate at a table beside a laptop."
	>
		<p>We help candidates understand what employers are looking for and identify relevant training or qualifications where appropriate.</p>
	</SplitFeature>

	<ContactSection title="Let’s discuss your recruitment needs" note="Opportunities depend on vacancy availability, employer selection and required employment checks." />
</BaseLayout>
