---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import { routes } from '../data/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Lomolink Consulting" description="The page you requested could not be found." noindex>
	<section class="py-12 lg:py-20">
		<Container class="text-center">
			<h1 class="font-display text-4xl font-semibold text-navy">Page not found</h1>
			<p class="mt-4 text-dark-grey">The page you are looking for does not exist.</p>
			<Button href={routes.home} variant="teal" class="mt-8">Return home</Button>
		</Container>
	</section>
</BaseLayout>
