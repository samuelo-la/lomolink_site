---
// Plain navy page header for pages without a photo hero (forms, Privacy Notice).
import Container from './Container.astro';

interface Props {
	eyebrow: string;
	title: string;
	intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="bg-navy py-10 text-white lg:py-16" data-dark>
	<Container>
		<p class="text-sm font-semibold tracking-[0.16em] text-gold uppercase">{eyebrow}</p>
		<h1 class="mt-4 max-w-3xl font-display text-[clamp(2.25rem,3.6vw,3rem)] leading-tight font-semibold text-balance">{title}</h1>
		{intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">{intro}</p>}
		<slot />
	</Container>
</section>
