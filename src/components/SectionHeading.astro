---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['text-center', className]}>
	<h2 class="font-display text-[28px] font-semibold leading-tight text-navy lg:text-4xl"><slot /></h2>
	<span class="mx-auto mt-4 block h-[3px] w-12 bg-gold" aria-hidden="true"></span>
</div>
