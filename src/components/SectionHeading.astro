---
interface Props {
	id?: string;
	align?: 'center' | 'left';
	class?: string;
}

const { id, align = 'center', class: className = '' } = Astro.props;
const centred = align === 'center';
---

<div class:list={[centred ? 'text-center' : 'text-left', className]}>
	<h2 id={id} class="font-display text-[28px] font-semibold leading-tight text-balance text-navy lg:text-4xl"><slot /></h2>
	<span class:list={['mt-4 block h-[3px] w-12 bg-gold', centred && 'mx-auto']} aria-hidden="true"></span>
</div>
