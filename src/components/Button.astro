---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'href'> {
	href: string;
	variant?: 'gold' | 'teal' | 'outline';
	size?: 'md' | 'sm';
	class?: string;
}

const {
	href,
	variant = 'teal',
	size = 'md',
	class: className = '',
	...rest
} = Astro.props;
const external = /^https?:\/\//.test(href);
const variantClasses = {
	gold: 'bg-gold text-navy hover:bg-gold/85 focus-visible:ring-white focus-visible:ring-offset-navy',
	teal: 'bg-teal text-white hover:bg-navy focus-visible:ring-teal focus-visible:ring-offset-white',
	outline: 'border border-white text-white hover:bg-white hover:text-navy focus-visible:ring-gold focus-visible:ring-offset-navy',
};
const sizeClasses = {
	md: 'px-6 py-3 text-base',
	sm: 'px-4 py-2 text-sm',
};
---

<a
	href={href}
	class:list={[
		'inline-flex items-center justify-center rounded-xl text-center font-semibold whitespace-nowrap transition duration-200 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:scale-[0.98]',
		variantClasses[variant],
		sizeClasses[size],
		className,
	]}
	{...rest}
	{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
	<slot />{external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
