---
import type { HTMLAttributes } from 'astro/types';

// Renders a link when href is given, otherwise a <button> (for forms).
type Props = Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class' | 'href' | 'type'> & {
	href?: string;
	type?: 'submit' | 'button';
	variant?: 'gold' | 'teal' | 'outline';
	size?: 'md' | 'sm';
	class?: string;
};

const { href, type = 'button', variant = 'teal', size = 'md', class: className = '', ...rest } = Astro.props;
const external = href ? /^https?:\/\//.test(href) : false;
const variantClasses = {
	gold: 'bg-gold text-navy hover:bg-gold/85 focus-visible:ring-white focus-visible:ring-offset-navy',
	teal: 'bg-teal text-white hover:bg-navy focus-visible:ring-teal focus-visible:ring-offset-white',
	outline: 'border border-white text-white hover:bg-white hover:text-navy focus-visible:ring-gold focus-visible:ring-offset-navy',
};
const sizeClasses = {
	md: 'px-6 py-3 text-base',
	sm: 'px-4 py-2 text-sm',
};
const classes = [
	'inline-flex items-center justify-center rounded-xl text-center font-semibold whitespace-nowrap transition duration-200 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-70',
	variantClasses[variant],
	sizeClasses[size],
	className,
];
---

{href ? (
	<a href={href} class:list={classes} {...rest} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
		<slot />{external && <span class="sr-only"> (opens in a new tab)</span>}
	</a>
) : (
	<button type={type} class:list={classes} {...rest}>
		<slot />
	</button>
)}
