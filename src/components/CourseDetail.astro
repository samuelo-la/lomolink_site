---
import type { Course } from '../data/courses';
import { enquiryHref } from '../data/routes';
import Button from './Button.astro';
import Icon from './icons/Icon.astro';

interface Props {
	course: Course;
	backHref: string;
}

const { course, backHref } = Astro.props;
const titleId = `${course.slug}-title`;
---

<article id={course.slug} class="flex h-full flex-col rounded-xl border border-navy/10 bg-white p-6 shadow-card sm:p-8" aria-labelledby={titleId}>
	<div class="flex items-center gap-4">
		<Icon name={course.icon} class="size-10 shrink-0 text-teal" />
		<h3 id={titleId} class="font-display text-2xl leading-snug font-semibold text-navy">{course.title}</h3>
	</div>
	<p class="mt-4 leading-relaxed text-dark-grey">{course.description}</p>

	<h4 class="mt-6 font-semibold text-navy">Qualifications you can explore</h4>
	<ul class="mt-3 space-y-2">
		{course.qualifications.map((qualification) => (
			<li class="flex gap-3 text-dark-grey"><span class="mt-2 size-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>{qualification}</li>
		))}
	</ul>

	<p class="mt-6 rounded-lg bg-teal-pale px-4 py-3 text-sm text-dark-grey">Availability, entry requirements and fees vary by programme. Please confirm these through an enquiry.</p>

	<div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-4 pt-6">
		<Button href={enquiryHref('consultation')} variant="teal" size="sm">Enquire about this area<span class="sr-only">: {course.title}</span></Button>
		<a href={backHref} class="text-sm font-semibold text-teal underline-offset-4 hover:text-navy hover:underline">Back to course areas</a>
	</div>
</article>
