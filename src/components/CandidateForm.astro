---
// Candidate registration. Posts to /candidate.php with an optional CV (PDF or .docx, max 5 MB).
import ChoiceGroup from './forms/ChoiceGroup.astro';
import FormField from './forms/FormField.astro';
import FormShell from './forms/FormShell.astro';

const f = 'candidate';
---

<FormShell
	action="/candidate.php"
	form={f}
	multipart
	submitLabel="Register your interest"
	privacyNote="We use your details to look for suitable roles and share them with employers only with your consent."
>
	<FormField form={f} name="name" label="Name" required maxlength={100} autocomplete="name" error="Please enter your name (up to 100 characters)." />
	<FormField form={f} name="email" label="Email address" type="email" required maxlength={150} autocomplete="email" error="Please enter a valid email address, for example name@example.com." />
	<FormField form={f} name="phone" label="Phone number" type="tel" maxlength={30} autocomplete="tel" hint="If you would like us to call you." error="Please enter a valid phone number, or leave it blank." />
	<FormField
		form={f}
		name="role"
		label="Preferred role"
		type="select"
		required
		error="Please choose your preferred role."
		options={[
			{ value: 'care-assistant', label: 'Care assistant' },
			{ value: 'support-worker', label: 'Support worker' },
			{ value: 'domiciliary-care-worker', label: 'Domiciliary care worker' },
			{ value: 'other', label: 'Other (tell us below)' },
		]}
	/>
	<FormField form={f} name="location" label="Town or area" required maxlength={100} autocomplete="address-level2" hint="Where you live or would like to work. Please do not give your full address." error="Please enter your town or area (up to 100 characters)." />
	<ChoiceGroup
		form={f}
		name="availability"
		legend="Availability"
		type="checkbox"
		hint="Tick all that apply."
		error="Please choose at least one option for your availability."
		options={[
			{ value: 'weekdays', label: 'Weekdays' },
			{ value: 'weekends', label: 'Weekends' },
			{ value: 'days', label: 'Day shifts' },
			{ value: 'nights', label: 'Night shifts' },
		]}
	/>
	<ChoiceGroup
		form={f}
		name="driving"
		legend="Driving"
		type="radio"
		error="Please tell us your driving status."
		options={[
			{ value: 'licence-car', label: 'Full UK licence and access to a car' },
			{ value: 'licence-no-car', label: 'Full UK licence, no car' },
			{ value: 'no-licence', label: 'No driving licence' },
		]}
	/>
	<FormField
		form={f}
		name="cv"
		label="CV"
		type="file"
		accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
		maxBytes={5 * 1024 * 1024}
		hint="PDF or Word (.docx), up to 5 MB. Please leave out your date of birth, health information and any ID or right-to-work documents."
		error="Please upload your CV as a PDF or Word (.docx) document under 5 MB."
	/>
	<FormField form={f} name="message" label="Anything else you would like us to know" type="textarea" rows={5} maxlength={2000} error="Please keep your message to 2,000 characters or fewer." />
	<FormField
		form={f}
		name="consent"
		type="checkbox"
		required
		label="I agree that Lomolink Consulting may share my details and CV with employers about suitable roles."
		hint="You can withdraw this at any time by emailing us."
		error="Please confirm that we may share your details with employers."
	/>
</FormShell>
