---
// Decorative stand-in until the owner supplies a licensed photo.
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div aria-hidden="true" class:list={['relative overflow-hidden bg-teal-pale', className]}>
	<span class="absolute -top-16 -right-10 size-56 rounded-full bg-teal/10"></span>
	<span class="absolute -bottom-20 left-1/4 size-72 rounded-full bg-gold/15"></span>
	<span class="absolute top-1/3 left-[12%] size-24 rounded-full border border-teal/20"></span>
</div>
