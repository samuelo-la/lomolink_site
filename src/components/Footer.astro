---
import { site } from '../data/site';
import Container from './Container.astro';
---

<footer class="bg-navy text-white" data-dark>
	<Container class="flex flex-col gap-4 py-8 text-sm lg:flex-row lg:items-center lg:justify-between">
		<div>
			<p class="font-semibold">{site.name}</p>
			<p class="mt-1 text-white/80">{site.email}</p>
		</div>
		<p class="text-white/80">&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
	</Container>
</footer>
