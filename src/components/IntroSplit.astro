---
import Button from './Button.astro';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	id: string;
	title: string;
	action?: { label: string; href: string };
	background?: 'white' | 'cream';
}

const { id, title, action, background = 'white' } = Astro.props;
// With an action, the button sits under the text until there is room for a third column at xl.
const columns = action
	? 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] xl:grid-cols-[minmax(0,4fr)_minmax(0,6fr)_auto]'
	: 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]';
---

<section class:list={['py-12 lg:py-20', background === 'cream' ? 'bg-cream' : 'bg-white']} aria-labelledby={id}>
	<Container class={`grid gap-6 lg:items-center lg:gap-12 ${columns}`}>
		<SectionHeading id={id} align="left">{title}</SectionHeading>
		<div class="space-y-3 text-lg leading-relaxed text-dark-grey lg:border-l lg:border-teal/40 lg:pl-12">
			<slot />
		</div>
		{action && <div class="lg:col-start-2 lg:pl-12 xl:col-start-auto xl:justify-self-end xl:pl-0"><Button href={action.href} variant="teal">{action.label}</Button></div>}
	</Container>
</section>
