---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/paths';

interface Props {
	items: { icon: IconName; title: string; text: string }[];
}

const { items } = Astro.props;
---

<ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0">
	{items.map((item, i) => (
		<li class="lg:border-l lg:border-navy/15 lg:px-8 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0" data-reveal data-reveal-delay={String(i)}>
			<div class="flex items-center gap-3">
				<Icon name={item.icon} class="size-9 shrink-0 text-teal" />
				<h3 class="font-display text-xl font-semibold text-navy">{item.title}</h3>
			</div>
			<p class="mt-3 leading-relaxed text-dark-grey">{item.text}</p>
		</li>
	))}
</ul>
