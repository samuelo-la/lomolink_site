---
// Card with a large icon and a divider on the left. With href the whole card links; without it the card is information only.
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/paths';

interface Props {
	icon: IconName;
	title: string;
	/** Omit for a compact title-only tile. */
	text?: string;
	href?: string;
	linkLabel?: string;
}

const { icon, title, text, href, linkLabel } = Astro.props;
---

<article
	class:list={[
		'group relative flex h-full gap-4 rounded-xl border border-navy/10 bg-white p-6 shadow-card',
		text ? 'sm:gap-6 lg:p-8' : 'sm:gap-5',
		href && 'transition duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover',
	]}
>
	<Icon name={icon} class:list={['shrink-0 text-teal', text ? 'size-10 sm:size-12' : 'size-10']} />
	<span class="w-px shrink-0 self-stretch bg-teal/40" aria-hidden="true"></span>
	<div class:list={['flex flex-col', !text && 'justify-center']}>
		<h3 class:list={['font-display leading-snug font-semibold text-navy', text ? 'text-xl lg:text-2xl' : 'text-xl']}>{title}</h3>
		{text && <p class="mt-2 leading-relaxed text-dark-grey">{text}</p>}
		{href && (
			<p class="mt-auto pt-4">
				<a href={href} class="font-semibold text-teal transition-colors hover:text-navy after:absolute after:inset-0 after:rounded-xl">
					{linkLabel ?? `Find out more about ${title}`}<Icon name="arrow-right" class="ml-2 inline size-4 align-[-0.15em] transition-transform duration-200 group-hover:translate-x-1" />
				</a>
			</p>
		)}
	</div>
</article>
