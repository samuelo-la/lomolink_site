---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Container from './Container.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Action {
	label: string;
	href: string;
}

interface Props {
	eyebrow: string;
	/** Each entry becomes its own line from 1024px upward. */
	titleLines: string[];
	text: string;
	primary?: Action;
	secondary?: Action;
	image?: ImageMetadata;
	imageAlt?: string;
	/** Literal Tailwind object-position class, e.g. "object-[65%_50%]", to keep the subject in frame. */
	imagePosition?: string;
}

const { eyebrow, titleLines, text, primary, secondary, image, imageAlt = '', imagePosition = 'object-center' } = Astro.props;
---

<section class="relative overflow-hidden bg-navy text-white" data-dark>
	<Container class="relative z-10">
		<div class="py-12 sm:py-16 lg:w-[47%] lg:py-20 lg:pr-8 motion-safe:animate-fade-up">
			<p class="text-xs font-semibold tracking-[0.16em] whitespace-nowrap text-gold uppercase sm:text-sm">{eyebrow}</p>
			<h1 class="mt-4 font-display text-[clamp(2.25rem,3.6vw,3.25rem)] leading-[1.1] font-semibold text-balance">
				{titleLines.map((line, i) => <Fragment>{i > 0 && ' '}<span class="lg:block">{line}</span></Fragment>)}
			</h1>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90">{text}</p>
			{(primary || secondary) && (
				<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
					{primary && <Button href={primary.href} variant="gold">{primary.label}</Button>}
					{secondary && <Button href={secondary.href} variant="outline">{secondary.label}</Button>}
				</div>
			)}
		</div>
	</Container>

	<div class="relative aspect-[16/10] sm:aspect-[2/1] lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:hero-media lg:[clip-path:polygon(4rem_0,100%_0,100%_100%,0_100%)] motion-safe:lg:animate-slide-in">
		{image ? (
			<Image src={image} alt={imageAlt} class:list={['size-full object-cover', imagePosition]} loading="eager" fetchpriority="high" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 55vw, 100vw" />
		) : (
			<ImagePlaceholder class="size-full" />
		)}
	</div>
</section>
