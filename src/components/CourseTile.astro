---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/paths';

interface Props {
	icon: IconName;
	title: string;
	href: string;
}

const { icon, title, href } = Astro.props;
---

<a href={href} class="flex h-full items-center gap-5 rounded-xl bg-teal-pale px-6 py-5 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover">
	<Icon name={icon} class="size-10 shrink-0 text-teal" />
	<span class="font-display text-lg leading-snug font-semibold text-navy">{title}</span>
</a>
