---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/paths';

interface Props {
	icon: IconName;
	title: string;
	text: string;
	href?: string;
	linkLabel?: string;
}

const { icon, title, text, href, linkLabel = 'Learn more' } = Astro.props;
---

<article class="group relative flex h-full gap-4 rounded-xl border border-navy/10 bg-white p-6 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover">
	<Icon name={icon} class="size-10 shrink-0 text-teal" />
	<div class="flex flex-col">
		<h3 class="font-display text-xl leading-snug font-semibold text-navy">{title}</h3>
		<p class="mt-2 leading-relaxed text-dark-grey">{text}</p>
		{href && (
			<a href={href} class="mt-4 inline-flex w-fit items-center gap-2 font-semibold text-teal transition-colors hover:text-navy after:absolute after:inset-0 after:rounded-xl">
				{linkLabel}<span class="sr-only"> about {title.toLowerCase()}</span>
				<Icon name="arrow-right" class="size-4 transition-transform duration-200 group-hover:translate-x-1" />
			</a>
		)}
	</div>
</article>
