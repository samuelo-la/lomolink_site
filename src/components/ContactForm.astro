---
// Plain HTML form that posts to /contact.php and works without JavaScript.
// main.js upgrades it: inline validation, fetch submission and topic prefill.
import { routes } from '../data/routes';
import Button from './Button.astro';

const fieldClasses =
	'mt-2 block w-full rounded-xl border border-navy/25 bg-white px-4 py-3 text-dark-grey transition-colors focus-visible:border-teal aria-[invalid=true]:border-red-700';
const labelClasses = 'block font-semibold text-navy';
const errorClasses = 'mt-2 hidden text-sm font-medium text-red-700';
---

<form action="/contact.php" method="post" class="relative space-y-6" data-contact-form>
	<!-- Shown without JavaScript when contact.php redirects to /contact/?error=1#form-error -->
	<div id="form-error" class="hidden rounded-xl border border-red-700/30 bg-red-50 p-4 text-red-800 target:block" role="alert">
		<p class="font-semibold">Sorry, your message could not be sent.</p>
		<p class="mt-1 text-sm">Please check your details and try again, or contact us by email or telephone.</p>
	</div>

	<div>
		<label for="contact-name" class={labelClasses}>Name</label>
		<input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" class={fieldClasses} />
		<p id="contact-name-error" class={errorClasses} data-error-for="name"></p>
	</div>

	<div>
		<label for="contact-email" class={labelClasses}>Email address</label>
		<input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="150" class={fieldClasses} />
		<p id="contact-email-error" class={errorClasses} data-error-for="email"></p>
	</div>

	<div>
		<label for="contact-message" class={labelClasses}>Message</label>
		<p id="contact-message-hint" class="mt-1 text-sm text-dark-grey">Tell us a little about what you are looking for (10 to 2,000 characters).</p>
		<textarea id="contact-message" name="message" rows="7" required minlength="10" maxlength="2000" aria-describedby="contact-message-hint" class={fieldClasses}></textarea>
		<p id="contact-message-error" class={errorClasses} data-error-for="message"></p>
	</div>

	<!-- Spam trap: hidden from people and assistive technology. Anything typed here is discarded. -->
	<div class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true">
		<label for="contact-website">Leave this field empty</label>
		<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<div>
		<Button type="submit" variant="teal" class="w-full sm:w-auto" data-submit>Send message</Button>
		<p class="mt-4 text-sm text-dark-grey">
			We use your details only to reply to your enquiry. Read our <a href={routes.privacy} class="font-semibold text-teal underline underline-offset-4 hover:text-navy">Privacy Notice</a>.
		</p>
	</div>

	<p class="rounded-xl text-base font-medium empty:hidden data-[state=error]:bg-red-50 data-[state=error]:p-4 data-[state=error]:text-red-800 data-[state=success]:bg-teal-pale data-[state=success]:p-4 data-[state=success]:text-navy" role="status" aria-live="polite" data-form-status></p>
</form>
