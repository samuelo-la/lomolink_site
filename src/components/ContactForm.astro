---
// General contact form: name, email, message. Posts to /contact.php.
import FormField from './forms/FormField.astro';
import FormShell from './forms/FormShell.astro';
---

<FormShell action="/contact.php" form="contact" submitLabel="Send message" privacyNote="We use your details only to reply to your enquiry." topicPrefill>
	<FormField form="contact" name="name" label="Name" required maxlength={100} autocomplete="name" error="Please enter your name (up to 100 characters)." />
	<FormField form="contact" name="email" label="Email address" type="email" required maxlength={150} autocomplete="email" error="Please enter a valid email address, for example name@example.com." />
	<FormField
		form="contact"
		name="message"
		label="Message"
		type="textarea"
		rows={7}
		required
		minlength={10}
		maxlength={2000}
		hint="Tell us a little about what you are looking for (10 to 2,000 characters)."
		error="Please write a message between 10 and 2,000 characters."
	/>
</FormShell>
