---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/paths';

interface Props {
	icon: IconName;
	title: string;
	summary: string;
	href: string;
}

const { icon, title, summary, href } = Astro.props;
---

<article class="group relative flex h-full gap-4 rounded-xl border border-navy/10 bg-white p-6 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover sm:gap-6 lg:p-8">
	<Icon name={icon} class="size-10 shrink-0 text-teal sm:size-12" />
	<span class="w-px shrink-0 self-stretch bg-teal/40" aria-hidden="true"></span>
	<div class="flex flex-col">
		<h3 class="font-display text-xl leading-snug font-semibold text-navy lg:text-2xl">{title}</h3>
		<p class="mt-2 leading-relaxed text-dark-grey">{summary}</p>
		<p class="mt-auto pt-4">
			<a href={href} class="font-semibold text-teal transition-colors hover:text-navy after:absolute after:inset-0 after:rounded-xl">
				Find out more about {title}<Icon name="arrow-right" class="ml-2 inline size-4 align-[-0.15em] transition-transform duration-200 group-hover:translate-x-1" />
			</a>
		</p>
	</div>
</article>
