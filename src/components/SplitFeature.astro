---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Container from './Container.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	id: string;
	title: string;
	action?: { label: string; href: string };
	image?: ImageMetadata;
	imageAlt?: string;
	background?: 'cream' | 'white';
}

const { id, title, action, image, imageAlt = '', background = 'cream' } = Astro.props;
---

<section class:list={['py-12 lg:py-20', background === 'cream' ? 'bg-cream' : 'bg-white']} aria-labelledby={id}>
	<Container class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
		<div data-reveal>
			{image ? (
				<Image src={image} alt={imageAlt} class="aspect-[4/3] w-full rounded-xl object-cover shadow-card" widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 100vw" />
			) : (
				<ImagePlaceholder class="aspect-[4/3] w-full rounded-xl shadow-card" />
			)}
		</div>
		<div data-reveal data-reveal-delay="1">
			<SectionHeading id={id} align="left">{title}</SectionHeading>
			<div class="mt-6 max-w-xl space-y-4 text-lg leading-relaxed text-dark-grey">
				<slot />
			</div>
			{action && <Button href={action.href} variant="teal" class="mt-8">{action.label}</Button>}
		</div>
	</Container>
</section>
