---
import { enquiryHref, isNavGroup, mainNav, navLinks } from '../data/routes';
import Button from './Button.astro';
import Container from './Container.astro';
import Icon from './icons/Icon.astro';
import Wordmark from './Wordmark.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
const underline =
	'relative py-1 whitespace-nowrap transition-colors duration-200 hover:text-gold after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-gold after:transition-transform after:duration-200 hover:after:scale-x-100';
const linkClasses = `${underline} inline-block aria-[current=page]:after:scale-x-100`;
// Group button: label and arrow kept side by side.
const groupClasses = `${underline} inline-flex items-center gap-1`;
---

<header
	class="group/header sticky top-0 z-40 bg-navy after:pointer-events-none after:absolute after:inset-0 after:opacity-0 after:shadow-lg after:transition-opacity after:duration-200 data-[scrolled]:after:opacity-100"
	data-navbar
	data-dark
>
	<Container class="flex items-center justify-between gap-6 py-4 group-data-[scrolled]/header:py-2.5">
		<Wordmark />

		<!-- Full menu from xl (1280px): the "Refugee Education Support" label does not fit beside the logo at 1024px. -->
		<nav aria-label="Main" class="hidden items-center gap-8 xl:flex">
			<ul class="flex items-center gap-7 text-sm font-medium text-white">
				{mainNav.map((item) =>
					isNavGroup(item) ? (
						<li class="relative">
							<!-- Opens on click or tap (works without JavaScript); main.js closes it on outside click, Escape or a link tap. -->
							<details class="group/drop" data-nav-dropdown>
								<summary
									class:list={[
										groupClasses,
										'cursor-pointer list-none [&::-webkit-details-marker]:hidden',
										item.children.some((child) => isCurrent(child.href)) && 'after:scale-x-100',
									]}
								>
									{item.label}
									<Icon name="chevron-down" class="size-4 transition-transform duration-200 group-open/drop:rotate-180" />
								</summary>
								<ul class="absolute top-full left-1/2 mt-3 w-60 -translate-x-1/2 rounded-xl border border-navy/10 bg-white py-2 shadow-card-hover">
									{item.children.map((child) => (
										<li>
											<a
												href={child.href}
												class="block px-5 py-2.5 text-dark-grey transition-colors hover:bg-teal-pale hover:text-navy aria-[current=page]:font-semibold aria-[current=page]:text-teal"
												aria-current={isCurrent(child.href) ? 'page' : undefined}
												data-dropdown-link
											>
												{child.label}
											</a>
										</li>
									))}
								</ul>
							</details>
						</li>
					) : (
						<li><a href={item.href} class={linkClasses} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
					),
				)}
			</ul>
			<Button href={enquiryHref()} variant="gold" size="sm">Get in touch</Button>
		</nav>

		<details class="group/menu xl:hidden" data-mobile-menu>
			<summary class="flex cursor-pointer list-none rounded-md p-2 text-white [&::-webkit-details-marker]:hidden" aria-label="Menu" data-menu-summary>
				<Icon name="menu" class="size-6 group-open/menu:hidden" />
				<Icon name="close" class="hidden size-6 group-open/menu:block" />
			</summary>
			<div class="absolute inset-x-0 top-full border-t border-white/10 bg-navy shadow-lg">
				<nav aria-label="Main">
					<Container>
						<ul class="flex flex-col gap-1 py-4 text-base font-medium text-white">
							{navLinks.map((link) => (
								<li>
									<a href={link.href} class="block rounded-md py-2 transition-colors hover:text-gold aria-[current=page]:text-gold" data-menu-link aria-current={isCurrent(link.href) ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))}
							<li class="pt-3">
								<Button href={enquiryHref()} variant="gold" size="sm" data-menu-link>Get in touch</Button>
							</li>
						</ul>
					</Container>
				</nav>
			</div>
		</details>
	</Container>
</header>
