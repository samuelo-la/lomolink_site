---
import { site } from '../data/site';
import Button from './Button.astro';
import Container from './Container.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About Us' },
	{ href: '/education-training/', label: 'Education & Training' },
	{ href: '/refugee-support/', label: 'Refugee Support' },
	{ href: '/recruitment/', label: 'Recruitment' },
];
const enquiryUrl = site.enquiryUrl || '/contact/';
---

<header class="sticky top-0 z-40 bg-navy transition-shadow duration-200" data-navbar>
	<nav aria-label="Main navigation">
		<Container class="flex items-center justify-between py-4 transition-[padding] duration-200" data-navbar-inner>
			<a href="/" class="shrink-0 font-display text-xl font-semibold tracking-wide text-white">
				<span>{site.name}</span>
				<span class="mt-1 block h-0.5 w-12 bg-gold" aria-hidden="true"></span>
			</a>
			<button
				type="button"
				class="rounded-md p-2 text-white lg:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Toggle navigation menu"
				data-menu-toggle
			>
				<span class="sr-only">Menu</span>
				<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
			<div class="hidden items-center gap-8 lg:flex">
				<div class="flex items-center gap-6 text-sm font-medium text-white">
					{links.map((link) => <a href={link.href}>{link.label}</a>)}
				</div>
				<Button href={enquiryUrl} variant="gold" size="sm">Get in touch</Button>
			</div>
		</Container>
	</nav>
	<div id="mobile-menu" class="hidden border-t border-white/10 lg:hidden" data-mobile-menu>
		<nav aria-label="Mobile navigation">
			<Container class="flex flex-col gap-4 py-4 text-sm font-medium text-white">
				{links.map((link) => <a href={link.href} data-menu-link>{link.label}</a>)}
				<Button href={enquiryUrl} variant="gold" size="sm" class="w-fit" data-menu-link>Get in touch</Button>
			</Container>
		</nav>
	</div>
</header>
