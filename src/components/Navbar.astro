---
import { site } from '../data/site';
import Button from './Button.astro';
import Container from './Container.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About Us' },
	{ href: '/education-training/', label: 'Education & Training' },
	{ href: '/refugee-support/', label: 'Refugee Support' },
	{ href: '/recruitment/', label: 'Recruitment' },
];
const enquiryUrl = site.enquiryUrl || '/contact/';
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="group sticky top-0 z-40 bg-navy transition-shadow duration-200 motion-reduce:transition-none data-[scrolled]:shadow-lg" data-navbar data-dark>
	<nav aria-label="Main navigation">
		<Container class="flex items-center justify-between py-4 transition-[padding] duration-200 motion-reduce:transition-none group-data-[scrolled]:py-3" data-navbar-inner>
			<a href="/" class="shrink-0 font-display text-xl font-semibold tracking-wide text-white">
				<span>{site.name}</span>
				<span class="mt-1 block h-0.5 w-12 bg-gold" aria-hidden="true"></span>
			</a>
			<details class="xl:hidden" data-mobile-menu>
				<summary class="flex cursor-pointer list-none rounded-md p-2 text-white marker:hidden" aria-label="Open navigation menu" data-menu-summary>
					<span class="sr-only">Menu</span>
					<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</summary>
				<nav aria-label="Mobile navigation" class="absolute inset-x-0 top-full border-t border-white/10 bg-navy">
					<Container class="flex flex-col gap-4 py-4 text-sm font-medium text-white">
						{links.map((link) => <a href={link.href} class="transition-colors hover:text-gold" data-menu-link aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
						<Button href={enquiryUrl} variant="gold" size="sm" class="w-fit" data-menu-link>Get in touch</Button>
					</Container>
				</nav>
			</details>
			<div class="hidden items-center gap-8 xl:flex">
				<div class="flex items-center gap-6 text-sm font-medium text-white">
					{links.map((link) => <a href={link.href} class="transition-colors hover:text-gold" aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
				</div>
				<Button href={enquiryUrl} variant="gold" size="sm">Get in touch</Button>
			</div>
		</Container>
	</nav>
</header>
